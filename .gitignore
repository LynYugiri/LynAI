# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# 鸿蒙构建期间由 scripts/ohos-pub-get.sh 临时生成：生效中的覆盖文件与
# 锁文件备份都不入库，避免影响其它平台的依赖解析。
/pubspec_overrides.yaml
/pubspec.lock.ohos-backup

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Shared CMake FetchContent cache for tree-sitter grammars (one copy per tag,
# reused across ABIs and build types instead of cloned per ABI).
/native/tree_sitter/.fetch-cache/

# ncnn + opencv-mobile prebuilt Android libraries (fetched by scripts/fetch-ncnn-deps.sh).
/android/app/src/main/jni/ncnn-android/
/android/app/src/main/jni/opencv-mobile/

# PPOCRv5 ncnn models (fetched by scripts/fetch-ncnn-deps.sh).
/android/app/src/main/assets/ocr_models/

# 鸿蒙签名材料（私钥库/CSR/证书/Profile）与密钥库密码都不入库：
# 它们只用于本地签名，丢失或泄露都会导致无法覆盖安装 / 需要重新申请证书。
/ohos/signature/
